VITE_SQLITE_SERVER_BASE=http://localhost:3001

# Used by server/sqlite-api.mjs to talk to Fireflies
FIREFLIES_API_KEY=your_fireflies_api_key_here

# Used by server/apis.mjs to rewrite ambiguous follow-ups
GROQ_API_KEY=your_groq_api_key_here

# Used by server/apis.mjs for HubSpot CRM (deals, companies, contacts, notes, emails)
HUBSPOT_API_KEY=your_hubspot_private_app_token_here

# Optional: where the SQLite file should be stored
SQLITE_PATH=./data/merlin.sqlite

# Comma-separated list of names to redact from transcripts, titles, and summaries
# REDACTED_NAMES=Alice Smith,Bob Jones

# Comma-separated list of host names to exclude from sync (exact match, case-insensitive)
# EXCLUDED_HOSTS=alice smith,bob jones

# Comma-separated list of meeting title substrings to exclude from sync (case-insensitive)
# EXCLUDED_TITLES=weekly sales huddle,team standup

# Comma-separated list of email domains considered internal (participants with only internal
# domains cause the meeting to be marked as internal-only and excluded from sync)
# INTERNAL_DOMAINS=yourcompany.com,fireflies.ai

# Comma-separated keywords that flag a meeting as a hiring call (excluded from sync)
# HIRING_KEYWORDS=round,interview,candidate,hiring

