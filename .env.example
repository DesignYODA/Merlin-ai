VITE_SQLITE_SERVER_BASE=http://localhost:3001

# Used by server/sqlite-api.mjs to talk to Fireflies
FIREFLIES_API_KEY=your_fireflies_api_key_here

# Used by server/apis.mjs to rewrite ambiguous follow-ups
GROQ_API_KEY=your_groq_api_key_here

# Used by server/apis.mjs for HubSpot CRM (deals, companies, contacts, notes, emails)
HUBSPOT_API_KEY=your_hubspot_private_app_token_here

# Optional: where the SQLite file should be stored
SQLITE_PATH=./data/merlin.sqlite

